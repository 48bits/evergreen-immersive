{
  "name": "evergreen-immersive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write index.html src scripts tests *.json *.ts *.mjs *.md"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/three": "0.185.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
